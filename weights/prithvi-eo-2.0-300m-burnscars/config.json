{
  "architectures": [
    "Terratorch"
  ],
  "num_classes": 0,
  "pretrained_cfg": {
    "input":{
      "target": "pixel_values",
      "data":{
        "pixel_values":{
          "type": "torch.Tensor",
          "shape": [6, 512, 512]
        },
        "location_coords":{
          "type":"torch.Tensor",
          "shape": [1, 2]
        }
      }
    },
    "model": {
      "class_path": "terratorch.tasks.SemanticSegmentationTask",
      "init_args": {
        "model_factory": "EncoderDecoderFactory",
        "model_args": {
          "backbone": "prithvi_eo_v2_300",
          "backbone_pretrained": true,
          "backbone_bands": [
            "BLUE",
            "GREEN",
            "RED",
            "NIR_NARROW",
            "SWIR_1",
            "SWIR_2"
          ],
          "necks": [
            {
              "name": "SelectIndices",
              "indices": [
                5,
                11,
                17,
                23
              ]
            },
            {
              "name": "ReshapeTokensToImage"
            },
            {
              "name": "LearnedInterpolateToPyramidal"
            }
          ],
          "decoder": "UNetDecoder",
          "decoder_channels": [
            512,
            256,
            128,
            64
          ],
          "num_classes": 2
        },
        "loss": "ce",
        "ignore_index": -1,
        "freeze_backbone": false,
